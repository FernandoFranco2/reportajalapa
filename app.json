{
  "expo": {
    "name": "ReportaJalapa",
    "slug": "reportajalapa-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E141B",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.reportajalapaapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0E141B"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "ReportaJalapa usa la cámara para tomar la foto del problema.",
          "photosPermission": "ReportaJalapa usa tus fotos para adjuntar la evidencia."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ReportaJalapa usa tu ubicación para marcar dónde está el problema."
        }
      ],
      "expo-font"
    ]
  }
}
